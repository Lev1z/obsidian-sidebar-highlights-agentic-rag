{
	"name": "obsidian-sidebar-highlights-agentic-rag",
	"version": "1.36.0",
	"description": "Manage Obsidian highlights, comments, collections, and tasks with an optional local-first Agentic RAG assistant.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "npm run build && npm test -- --runInBand",
		"ci": "npm run build && npm run test:coverage",
		"eval:retrieval": "jest --runInBand src/evals/retrieval-benchmark.test.ts",
		"test": "jest",
		"test:coverage": "jest --coverage --runInBand",
		"test:watch": "jest --watch",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"highlights",
		"rag",
		"agentic-ai"
	],
	"author": "Lev1z and Sidebar Highlights contributors",
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@langchain/core": "^0.3.57",
		"@types/jest": "^29.5.11",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.1.1",
		"tslib": "2.4.0",
		"typescript": "^5.6.3"
	}
}
